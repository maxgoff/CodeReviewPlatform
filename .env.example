# --- Model ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
REVIEW_MODEL=claude-sonnet-5-5
# Leave unset to use the mock reviewer automatically when no API key is present.
# USE_MOCK_LLM=false

# --- Review policy -------------------------------------------------------
REVIEW_SPECIALISTS=security,correctness,maintainability
REVIEW_MIN_CONFIDENCE=0.7
REVIEW_MAX_COMMENTS=15
REVIEW_MAX_FILE_LINES=1500
REVIEW_CHUNK_CHAR_BUDGET=60000
REVIEW_WARM_CACHE=true

# --- GitHub --------------------------------------------------------------
# Fine-grained token with "Pull requests: Read and write" + "Contents: Read" on the target repo.
GITHUB_TOKEN=github_pat_...
GITHUB_WEBHOOK_SECRET=change-me
# With no GITHUB_TOKEN the server runs in dry-run mode: it reviews DRY_RUN_DIFF_PATH and writes
# the review JSON to DRY_RUN_OUTPUT_DIR instead of calling GitHub.
# GITHUB_DRY_RUN=true
# DRY_RUN_DIFF_PATH=samples/vulnerable_pr.diff
# DRY_RUN_OUTPUT_DIR=out

# --- Whole-repository reviews (reviewbot repo / POST /repo-reviews) ---------
# REPO_MAX_FILES=150
# REPO_BUDGET_USD=2.00
# REVIEW_MAX_CONCURRENCY=4
# REVIEWBOT_API_TOKEN=change-me

# --- Server ---------------------------------------------------------------
# REVIEWBOT_PORT=27183          # web UI and API: http://localhost:27183
# REVIEWBOT_HOST=127.0.0.1      # 0.0.0.0 to accept other machines; set REVIEWBOT_API_TOKEN too
